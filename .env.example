# --- GitHub App ---
# https://github.com/settings/apps 에서 생성 후 채운다
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# 개인키는 파일 경로로 준다 (PEM 내용을 env에 직접 넣지 않는다)
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem

# --- LLM (OpenAI 호환) ---
# 로컬: Ollama          -> http://localhost:11434/v1
# 배포: vLLM (GSM SV)   -> http://llm:8000/v1
# 이 두 값만 바꾸면 로컬 <-> 배포가 전환되어야 한다. 다른 코드는 손대지 않는다.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:26b
LLM_API_KEY=ollama
LLM_TIMEOUT_S=120

# gemma4는 추론 모델이다. "none"이면 사고를 끈다 (측정: 4.1초 -> 0.6초).
# 사고를 켜면 max_tokens를 전부 사고에 쓰고 본문이 잘리는 일이 생긴다.
# none | low | medium | high
LLM_REASONING_EFFORT=none

# 임베딩 (RAG, Phase 3)
EMBED_MODEL=embeddinggemma

# --- 리뷰 동작 ---
REVIEW_TRIGGER=/review
# 요약 모드 폴백 임계값. 사실상 꺼둔 상태 (지금의 폴백은 시간을 실제로 못 줄인다)
REVIEW_MAX_LINES=100000
# 진행 상태 코멘트 PATCH 최소 간격 (GitHub secondary rate limit 회피)
PROGRESS_DEBOUNCE_S=2.0

# 파일당 출력 토큰 상한. 잘림 방지용 안전장치.
# 실측(gemma4:26b, 28 tok/s)에서 정상 리뷰는 80~174토큰.
REVIEW_MAX_OUTPUT_TOKENS=800
REVIEW_MAX_FINDINGS_PER_FILE=5

LOG_LEVEL=INFO
